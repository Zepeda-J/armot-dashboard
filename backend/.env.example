# --- Servidor ---
PORT=4000

# --- Autenticación ---
# Cambia este secreto en producción (usa una cadena larga y aleatoria).
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=12h

# --- (Ya no se usa SQLite: usuarios y servicios viven en Supabase) ---

# --- Asistente de IA (Gemini) ---
# Déjalo vacío para desactivar el asistente sin que truene el servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Drive (explorador de archivos) ---
# Ruta al JSON de la cuenta de servicio de Google (con acceso de lector a la carpeta).
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- CORS ---
# URL donde corre el frontend en desarrollo.
FRONTEND_ORIGIN=http://localhost:5173

# --- Supabase (PostgreSQL): Coordinadores, Administración, Facturación y Acuerdos ---
# Es la misma conexión que tenías en .streamlit/secrets.toml ([connections.supabase] url = "...").
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres   (si trae "+psycopg2", déjalo: se limpia solo)
# Si la contraseña tiene caracteres especiales (@ : / # ?), codifícalos (por ejemplo @ -> %40).
DATABASE_URL=
